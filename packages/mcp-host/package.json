{
    "name": "@core2ai/mcp-host",
    "description": "MCP stdio host for generated tool modules (api2ai / db2ai)",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": ["out", "src"],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": ["out/index"]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out resources",
        "build": "tsc -b tsconfig.json",
        "build:clean": "npm run clean && npm run build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.29.0",
        "zod": "^4.4.3"
    }
}
